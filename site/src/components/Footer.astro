---
// Custom Starlight <Footer> override: renders the default footer, then a
// human-visible maintainer block that corroborates the Person node in the
// site-wide JSON-LD @graph (GEO: entity corroboration).
import Default from '@astrojs/starlight/components/Footer.astro';
// Experimental: the floating prototype switcher (colour direction, language
// detection mode) and the first-visit language suggestion. Both are mounted
// here because the footer is the one custom component rendered on every page,
// splash included; both position themselves fixed.
import PrototypeSwitcher from './PrototypeSwitcher.astro';
import LangSuggest from './LangSuggest.astro';

const path = Astro.url.pathname;
const lang = path.includes('/es/') || path.endsWith('/es') ? 'es' : 'en';
const text =
  lang === 'es'
    ? 'Creado y mantenido por'
    : 'Created and maintained by';
---

<Default><slot /></Default>
<div class="maintainer">
  {text}
  <a href="https://jmrp.io" rel="author">José Manuel Requena Plens</a>
  · <a href="https://github.com/jmrplens/phonometry">GitHub</a>
  · <a href="https://pypi.org/project/phonometry/">PyPI</a>
</div>
<LangSuggest />
<PrototypeSwitcher />

<style>
  .maintainer {
    margin-top: 1rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .maintainer a {
    color: var(--sl-color-text-accent);
  }
</style>
