---
/**
 * Auto-generated "what governs each page" table for section landing pages
 * (TOC-info variant "clean"; see TOC-REDESIGN-NOTES.md).
 *
 * When the current page is a sidebar group landing (the Overview-first
 * `data-group-link` convention), this renders a table of the group's pages
 * with their governing standards (teal) and named references (amber), all
 * sourced from the same `attrs['data-chips']` classification the sidebar
 * variants use. Nested subgroups become separator rows. Rendered on every
 * page (empty unless the page is a landing with annotated children) and
 * displayed only when `data-toc-style='clean'` is active (toc-info.css).
 */
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

type SidebarEntry = StarlightRouteData['sidebar'][number];
type SidebarLink = Extract<SidebarEntry, { type: 'link' }>;
type SidebarGroup = Extract<SidebarEntry, { type: 'group' }>;

interface Chip {
	text: string;
	class: string;
}

function parseChips(attrs: Record<string, unknown> | undefined): Chip[] {
	const raw = attrs?.['data-chips'];
	if (typeof raw !== 'string') return [];
	try {
		const list = JSON.parse(raw);
		return Array.isArray(list) ? (list as Chip[]) : [];
	} catch {
		return [];
	}
}

function isLanding(entry: SidebarEntry): entry is SidebarLink {
	return entry.type === 'link' && entry.attrs != null && 'data-group-link' in entry.attrs;
}

/** Find the group whose landing page is the current page. */
function findCurrentGroup(entries: SidebarEntry[]): SidebarGroup | undefined {
	for (const entry of entries) {
		if (entry.type !== 'group') continue;
		const [first] = entry.entries;
		if (first && isLanding(first) && first.isCurrent) return entry;
		const nested = findCurrentGroup(entry.entries);
		if (nested) return nested;
	}
	return undefined;
}

interface Row {
	kind: 'page' | 'subgroup';
	label: string;
	href?: string;
	standards: Chip[];
	references: Chip[];
}

function rows(group: SidebarGroup): Row[] {
	const out: Row[] = [];
	const [first, ...rest] = group.entries;
	const children = first && isLanding(first) ? rest : group.entries;
	for (const entry of children) {
		if (entry.type === 'link') {
			const chips = parseChips(entry.attrs);
			out.push({
				kind: 'page',
				label: entry.label,
				href: entry.href,
				standards: chips.filter((c) => c.class === 'chip-standard'),
				references: chips.filter((c) => c.class === 'chip-theory'),
			});
		} else {
			out.push({ kind: 'subgroup', label: entry.label, standards: [], references: [] });
			for (const row of rows(entry)) if (row.kind === 'page') out.push(row);
		}
	}
	return out;
}

const group = findCurrentGroup(Astro.locals.starlightRoute.sidebar);
const tableRows = group ? rows(group) : [];
const hasChips = tableRows.some((r) => r.standards.length > 0 || r.references.length > 0);
const isEs = Astro.currentLocale === 'es';
const heading = isEs ? 'Normas y referencias por página' : 'Standards and references by page';
const colPage = isEs ? 'Página' : 'Page';
const colStandards = isEs ? 'Normas' : 'Standards';
const colReferences = isEs ? 'Referencias clave' : 'Key references';
---

{
	group && hasChips && (
		<section class="section-standards">
			<h2 id="standards-by-page">{heading}</h2>
			{/* Starlight renders tables as scrollable blocks and the page names
			    push this one past a phone viewport, so the scroll container needs
			    an explicit tabindex for WCAG 2.1.1, exactly like the markdown
			    table transform in astro.config.mjs. */}
			<table tabindex="0">
				<thead>
					<tr>
						<th scope="col">{colPage}</th>
						<th scope="col">{colStandards}</th>
						<th scope="col">{colReferences}</th>
					</tr>
				</thead>
				<tbody>
					{tableRows.map((row) =>
						row.kind === 'subgroup' ? (
							<tr class="subgroup-row">
								<td colspan="3">{row.label}</td>
							</tr>
						) : (
							<tr>
								<td>
									<a href={row.href}>{row.label}</a>
								</td>
								<td>
									{row.standards.map((chip, i) => (
										<span class={chip.class}>
											{i > 0 && ', '}
											{chip.text}
										</span>
									))}
								</td>
								<td>
									{row.references.map((chip, i) => (
										<span class={chip.class}>
											{i > 0 && ', '}
											{chip.text}
										</span>
									))}
								</td>
							</tr>
						)
					)}
				</tbody>
			</table>
		</section>
	)
}
