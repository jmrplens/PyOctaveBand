---
/**
 * Experimental switcher for the two things this branch wants a decision on.
 *
 * Colour: three complete palettes live in src/styles/theme-directions.css,
 * keyed on a `data-accent` attribute on <html>. The attribute is stamped
 * before first paint by the inline script in Head.astro (so there is no
 * flash) and read back from localStorage under `phonometry:accent`; this
 * control only writes it.
 *
 * Language: the mode used by src/components/LangSuggest.astro, stored under
 * `phonometry:lang-mode`. Changing it reloads the page, because the decision
 * is taken once at load.
 *
 * Neither is meant to ship. Once a direction and a mode are picked, the
 * winning colour block becomes the unconditional `:root` rule, the mode
 * becomes the component's `DEFAULT_MODE`, and this component goes away.
 *
 * Rendered from Footer.astro so it exists on every page, splash included, and
 * positioned fixed. The buttons are real <button>s in labelled groups with
 * `aria-pressed`, so the control is reachable and announced; the panel starts
 * collapsed to stay out of the reading column.
 */
const DIRECTIONS = [
	{ id: 'instrument', label: 'Instrument' },
	{ id: 'blueprint', label: 'Blueprint' },
	{ id: 'graphite', label: 'Graphite' },
] as const;

const LANG_MODES = [
	{ id: 'banner', label: 'Banner' },
	{ id: 'redirect', label: 'Redirect' },
	{ id: 'off', label: 'Off' },
] as const;
---

<div class="accent-switcher" id="accent-switcher">
	<button
		type="button"
		class="accent-toggle"
		aria-expanded="false"
		aria-controls="accent-options"
		data-accent-toggle
	>
		<span class="accent-toggle-dot" aria-hidden="true"></span>
		<span class="accent-toggle-label">Prototype</span>
	</button>
	<div class="accent-options" id="accent-options" hidden>
		<div class="accent-group" role="group" aria-label="Colour direction">
			<span class="accent-group-label" aria-hidden="true">Colour</span>
			{
				DIRECTIONS.map((d) => (
					<button type="button" class="accent-option" data-accent-set={d.id} aria-pressed="false">
						<span class={`accent-swatch accent-swatch-${d.id}`} aria-hidden="true" />
						{d.label}
					</button>
				))
			}
		</div>
		<div class="accent-group" role="group" aria-label="Language detection mode">
			<span class="accent-group-label" aria-hidden="true">Language</span>
			{
				LANG_MODES.map((m) => (
					<button type="button" class="accent-option" data-lang-mode={m.id} aria-pressed="false">
						{m.label}
					</button>
				))
			}
		</div>
	</div>
</div>

<script is:inline>
	(() => {
		const root = document.documentElement;
		const KEY = 'phonometry:accent';
		const panel = document.getElementById('accent-switcher');
		if (!panel) return;
		const options = panel.querySelector('#accent-options');
		const toggle = panel.querySelector('[data-accent-toggle]');

		const LANG_MODE_KEY = 'phonometry:lang-mode';
		const read = (key, fallback) => {
			try {
				return localStorage.getItem(key) || fallback;
			} catch {
				return fallback;
			}
		};

		const sync = () => {
			const active = root.dataset.accent || 'instrument';
			for (const btn of panel.querySelectorAll('[data-accent-set]')) {
				btn.setAttribute('aria-pressed', String(btn.dataset.accentSet === active));
			}
			const banner = document.getElementById('lang-suggest');
			const mode = read(LANG_MODE_KEY, banner?.dataset.defaultMode || 'banner');
			for (const btn of panel.querySelectorAll('[data-lang-mode]')) {
				btn.setAttribute('aria-pressed', String(btn.dataset.langMode === mode));
			}
		};

		for (const btn of panel.querySelectorAll('[data-lang-mode]')) {
			btn.addEventListener('click', () => {
				try {
					localStorage.setItem(LANG_MODE_KEY, btn.dataset.langMode);
					// The suggestion is decided once at load, and the redirect
					// guard is per session, so both have to be reset to see the
					// new mode behave as it would on a first visit.
					localStorage.removeItem('phonometry:lang-dismissed');
					sessionStorage.removeItem('phonometry:lang-redirected');
				} catch {
					/* private mode */
				}
				location.reload();
			});
		}

		for (const btn of panel.querySelectorAll('[data-accent-set]')) {
			btn.addEventListener('click', () => {
				root.dataset.accent = btn.dataset.accentSet;
				try {
					localStorage.setItem(KEY, btn.dataset.accentSet);
				} catch {
					/* private mode: the choice just does not survive the tab */
				}
				sync();
			});
		}

		toggle?.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!open));
			if (options) options.hidden = open;
		});

		sync();
	})();
</script>

<style>
	.accent-switcher {
		position: fixed;
		inset-block-end: 0.75rem;
		inset-inline-end: 0.75rem;
		z-index: 50;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.375rem;
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-2xs);
		line-height: 1;
	}

	.accent-toggle,
	.accent-option {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.6rem;
		border: 1px solid var(--ph-border);
		border-radius: var(--ph-radius, 4px);
		background: var(--ph-surface-raised, var(--sl-color-bg));
		color: var(--sl-color-gray-2);
		cursor: pointer;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		box-shadow: var(--sl-shadow-sm);
	}

	.accent-toggle:hover,
	.accent-option:hover {
		border-color: var(--ph-border-strong);
		color: var(--sl-color-white);
	}

	.accent-toggle-dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--ph-mark);
	}

	.accent-options {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.6rem;
	}
	.accent-group {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.25rem;
	}
	.accent-group-label {
		color: var(--sl-color-gray-3);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding-inline-start: 0.1rem;
	}
	/* `display: flex` would otherwise beat the user-agent [hidden] rule. */
	.accent-options[hidden] {
		display: none;
	}

	.accent-option[aria-pressed='true'] {
		border-color: var(--ph-mark);
		color: var(--sl-color-white);
	}

	.accent-swatch {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 2px;
		border: 1px solid var(--ph-border-strong);
	}
	/* Fixed swatch colours: each one previews its own direction, so they
	   cannot follow the active palette's tokens. */
	.accent-swatch-instrument {
		background: linear-gradient(135deg, #0a6f8c 50%, #35b8d8 50%);
	}
	.accent-swatch-blueprint {
		background: linear-gradient(135deg, #23479a 50%, #78a2f0 50%);
	}
	.accent-swatch-graphite {
		background: linear-gradient(135deg, #8a4b06 50%, #e0a33e 50%);
	}

	/* The language suggestion is a full-width bar pinned to the same edge and
	   is rendered just before this component, so lift the panel clear of it
	   while it is showing. */
	:global(#lang-suggest:not([hidden])) ~ .accent-switcher {
		inset-block-end: calc(var(--ph-lang-bar-height, 3rem) + 0.75rem);
	}

	@media print {
		.accent-switcher {
			display: none;
		}
	}
</style>
